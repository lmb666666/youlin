{
  "name": "youlin",
  "version": "0.1.0",
  "private": true,
  "description": "友邻 Youlin — Neighbors of your blog. 友链 + 朋友圈管理台，跑在 Cloudflare Workers 上。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "pnpm --filter youlin-web dev",
    "build": "pnpm --filter youlin-web build",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter youlin-web typecheck",
    "seed": "wrangler d1 execute youlin --local --file=scripts/seed.sql"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261005.1",
    "ajv": "^8.17.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}

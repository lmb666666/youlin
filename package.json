{
  "name": "youlin",
  "version": "0.4.0",
  "private": true,
  "description": "友邻 Youlin — Neighbors of your blog. 友链 + 朋友圈管理台，Docker + SQLite 自托管。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "pnpm --filter youlin-web dev",
    "build": "pnpm --filter youlin-web build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node24 --external:better-sqlite3 --external:undici --external:pino --outfile=server/dist/main.mjs",
    "start": "node server/dist/main.mjs",
    "lint": "eslint .",
    "docs:config": "node scripts/gen-config-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && pnpm --filter youlin-web typecheck",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@youlin/contracts": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}

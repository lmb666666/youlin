{
  "name": "youlin",
  "version": "0.1.0",
  "private": true,
  "description": "友邻 Youlin — Neighbors of your blog. 友链 + 朋友圈管理台，跑在 Cloudflare Workers 上。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "pnpm --filter youlin-web dev",
    "build": "pnpm --filter youlin-web build",
    "deploy": "pnpm build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "lint": "eslint .",
    "docs:config": "node scripts/gen-config-docs.mjs",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && pnpm --filter youlin-web typecheck",
    "seed": "wrangler d1 execute youlin --local --file=scripts/seed.sql",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --outfile=server/dist/main.mjs",
    "dev:node": "tsx watch src/server/main.ts",
    "start:node": "node server/dist/main.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}

# 友邻 Youlin · Docker 环境变量
# 复制为 .env 后填写；.env 已在 .gitignore 里，不会被提交。

# ── 必填 ───────────────────────────────────────────────
# 管理台登录口令，同时作为会话签名密钥。请换成足够长的随机串：
#   openssl rand -hex 32
ADMIN_TOKEN=change-me-please

# ── 可选 ───────────────────────────────────────────────
# 申请页人机验证（开启 apply.turnstile 时才需要）
# TURNSTILE_SECRET=

# WebDAV 备份密码（设置页填地址与用户名，密码只从这里读）
# WEBDAV_PASSWORD=

# 触发接入方重建（GITHUB_PAT 仅在使用 github_dispatch 时需要）
# GITHUB_PAT=

# 部署级配置覆盖（JSON，扁平点号键），优先级高于设置页
# YOULIN_CONFIG_OVERRIDES={"site.url":"https://links.example.com"}

# 服务与调度
# PORT=8787
# HOST=0.0.0.0
# DB_PATH=/data/youlin.db
# CRON_ENABLED=true
# CRON_INTERVAL_SECONDS=300
